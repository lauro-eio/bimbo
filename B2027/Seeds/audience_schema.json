{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B2027_Audience_Guardrails_Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_name", "target_audience"],
  "properties": {
    "registry_name": {
      "type": "string",
      "const": "B2027_Audience_Guardrails"
    },
    "target_audience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "description",
        "constraint_level",
        "prefer",
        "avoid"
      ],
      "properties": {
        "profile": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "constraint_level": { "type": "string", "const": "MANDATORY" },
        "prefer": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "avoid": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
