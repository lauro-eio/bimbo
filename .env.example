# Copy to .env and set your key (never commit .env)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# HTML preview repo for --publish / --publish-all (optional; Bimbo should not publish into GO catalog)
# Local: egregor-content/go-preview — Vercel: https://go2-view.vercel.app — GitHub: https://github.com/lauro-eio/go2-view
# PREVIEW_REPO_PATH=../../go-preview

# Media generation — never commit real keys
ELEVENLABS_API_KEY=
# Optional TTS defaults (gen_audio.py)
# ELEVENLABS_VOICE_ID=CwhRBWXzGAHq8TQ4Fs17
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Image generation uses Gemini (gen_images.py) — same GEMINI_API_KEY as lesson gen
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
